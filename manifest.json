{
    "manifest_version": 3,
    "name": "Hide ok.ru top menu",
    "version": "1.0",
    "content_scripts": [
        {
            "matches": [
                "*://ok.ru/*"
            ],
            "js": [
                "inject.js"
            ],
            "run_at": "document_end",
            "all_frames": false
        }
    ]
}