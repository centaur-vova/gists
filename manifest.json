{
    "manifest_version": 3,
    "name": "Hide friends",
    "version": "1.0",
    "description": "🚫 Скрывает блок с друзьями на страницах профиля.",
    "content_scripts": [
        {
            "matches": [
                "*://ok.ru/*",
                "*://vk.ru/*"
            ],
            "js": [
                "inject.js"
            ],
            "run_at": "document_idle"
        }
    ]
}